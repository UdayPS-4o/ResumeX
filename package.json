{
  "name": "resumex",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "package"
  ],
  "scripts": {
    "setup": "npm install && node scripts/install-engine.mjs",
    "install-engine": "node scripts/install-engine.mjs",
    "predev": "node scripts/install-engine.mjs --auto",
    "dev": "concurrently --kill-others -n backend,frontend -c cyan,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:all": "concurrently --kill-others -n backend,frontend -c cyan,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm run dev",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
