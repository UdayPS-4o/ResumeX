# syntax=docker/dockerfile:1
# Resumex API (Express). Multi-stage: install workspace deps, then run.
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY . .
RUN npm ci
# Vendor the offline Typst engine.
RUN node scripts/install-engine.mjs --skip-warm || true

FROM node:20-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8000
COPY --from=build /app /app
EXPOSE 8000
CMD ["node", "apps/api/src/server.js"]
