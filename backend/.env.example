# Optional server-side defaults. Users can also supply their own keys from the UI.
PORT=8000

# `npm run setup` vendors a Typst binary into backend/vendor/ which the
# server auto-detects — normally no path is needed. This only overrides that,
# e.g. to point at a system install (unquoted — backslashes stay literal).
# TYPST_PATH=C:\Users\you\bin\typst.exe

# If set, the server will use these as fallbacks when the client doesn't send one.
# Leave blank in normal use — the frontend should send the key per-request.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
