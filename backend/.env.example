# Optional server-side defaults. Users can also supply their own keys from the UI.
PORT=8000

# LaTeX compilation mode: local | auto | online  (default: auto)
#   local  -> native engine (Tectonic/pdflatex) only, fully offline; errors if none installed.
#   auto   -> try local, fall back to online services if no engine found.
#   online -> force online services.
COMPILE_MODE=local

# `npm run setup` vendors a Tectonic binary into backend/vendor/ which the
# server auto-detects — normally no path is needed. These only override that,
# e.g. to point at a system install (unquoted — backslashes stay literal).
# TECTONIC_PATH=C:\Users\you\bin\tectonic.exe
# PDFLATEX_PATH=C:\texlive\bin\pdflatex.exe

# If set, the server will use these as fallbacks when the client doesn't send one.
# Leave blank in normal use — the frontend should send the key per-request.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
