# Optional server-side config. Most of this is auto-generated on first run — you
# normally don't need to set anything here.
PORT=8000

# `npm run setup` vendors a Typst binary into backend/vendor/ which the
# server auto-detects — normally no path is needed. This only overrides that,
# e.g. to point at a system install (unquoted — backslashes stay literal).
# TYPST_PATH=C:\Users\you\bin\typst.exe

# ── Secrets (auto-generated into backend/.env on first run if absent) ─────────
# AUTH_SECRET signs session cookies; ENCRYPTION_KEY (32-byte hex) encrypts the
# API keys stored in SQLite. You can pin them here to keep sessions/keys valid
# across machines — otherwise they're created for you. Do NOT commit real values.
# AUTH_SECRET=
# ENCRYPTION_KEY=

# ── Default (auto-seeded) user ───────────────────────────────────────────────
# Created on first boot. While it's the only account, it auto-logs-in (no login
# page). Once you add a 2nd user via /signup, log back in with these creds.
# DEFAULT_USER_USERNAME=admin
# DEFAULT_USER_EMAIL=admin@resumex.local
# DEFAULT_USER_PASSWORD=admin

# ── SQLite location (optional) ───────────────────────────────────────────────
# Defaults to backend/data/resumex.db (gitignored).
# DATABASE_URL=./data/resumex.db

# Optional provider key fallbacks — used only if a user has no stored key and
# didn't send one. Normally leave blank; keys are managed per-user in the UI.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
